{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "landing-hero-02",
  "title": "Landing hero, centred",
  "description": "A centred riso headline, two buttons, and the product on a taped page: a checklist you can tick (the bar, the tally and a stamp follow), margin notes and Stubby peeking over the edge. Looks right on paper or on the desk.",
  "registryDependencies": [
    "https://kevintngo.github.io/looseleaf/r/avatar.json",
    "https://kevintngo.github.io/looseleaf/r/button.json",
    "https://kevintngo.github.io/looseleaf/r/callout.json",
    "https://kevintngo.github.io/looseleaf/r/checkbox.json",
    "https://kevintngo.github.io/looseleaf/r/icon.json",
    "https://kevintngo.github.io/looseleaf/r/label.json",
    "https://kevintngo.github.io/looseleaf/r/lettering.json",
    "https://kevintngo.github.io/looseleaf/r/looseleaf-theme.json",
    "https://kevintngo.github.io/looseleaf/r/mascot.json",
    "https://kevintngo.github.io/looseleaf/r/paper.json",
    "https://kevintngo.github.io/looseleaf/r/progress.json",
    "https://kevintngo.github.io/looseleaf/r/ribbon.json",
    "https://kevintngo.github.io/looseleaf/r/stamp.json",
    "https://kevintngo.github.io/looseleaf/r/sticker.json",
    "https://kevintngo.github.io/looseleaf/r/tabs.json",
    "https://kevintngo.github.io/looseleaf/r/tally.json"
  ],
  "files": [
    {
      "path": "src/blocks/landing-hero-02/components/landing-hero-02-window.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\n\nimport { Avatar, AvatarFallback, AvatarGroup } from \"@/components/ui/avatar\"\nimport { Callout } from \"@/components/ui/callout\"\nimport { Checkbox } from \"@/components/ui/checkbox\"\nimport { Label } from \"@/components/ui/label\"\nimport { Mascot } from \"@/components/ui/mascot\"\nimport { Paper } from \"@/components/ui/paper\"\nimport { Progress } from \"@/components/ui/progress\"\nimport { Stamp } from \"@/components/ui/stamp\"\nimport { Sticker } from \"@/components/ui/sticker\"\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\"\nimport { Tally } from \"@/components/ui/tally\"\nimport { cn } from \"@/lib/utils\"\n\nconst TASKS = [\n  { id: \"invoices\", label: \"Send the invoices\", done: true },\n  { id: \"post\", label: \"Draft the launch post\", done: true },\n  { id: \"review\", label: \"Review Ada’s pull request\", done: false },\n  { id: \"offsite\", label: \"Book the offsite\", done: false },\n  { id: \"plant\", label: \"Water the plant\", done: false },\n]\n\nconst WEEK = [\n  { day: \"Mon\", value: 100 },\n  { day: \"Tue\", value: 80 },\n  { day: \"Wed\", value: 60 },\n  { day: \"Thu\", value: 20 },\n  { day: \"Fri\", value: 0 },\n]\n\nconst people = [\"Ada Lovelace\", \"Jo Okafor\", \"Sam Reyes\"]\n\nfunction LandingHero02Window({ className }: { className?: string }) {\n  const [done, setDone] = React.useState(() => Object.fromEntries(TASKS.map((t) => [t.id, t.done])) as Record<string, boolean>)\n  const count = Object.values(done).filter(Boolean).length\n  const all = count === TASKS.length\n\n  return (\n    <div data-slot=\"landing-hero-window\" className={className}>\n      <div className=\"relative mx-auto w-full max-w-3xl\">\n        <Mascot pose=\"peek\" size={112} className=\"pointer-events-none absolute end-12 bottom-[calc(100%-1.3rem)] [--ll-blend:normal]\" />\n        <Paper stock=\"paper\" tilt={0.5} tape=\"both\" tapeKind=\"washi-stripes\" shadow=\"lift\" seed=\"hero-window\" className=\"relative z-(--ll-z-raised) px-5 pt-5 pb-6 @xl:px-8 @xl:pb-10\">\n          <div className=\"flex items-center justify-between gap-4\">\n            <p className=\"font-script text-2xl leading-none font-bold text-ink\">\n              penmark <span className=\"font-hand text-base font-normal text-ink-muted\">/ week 39</span>\n            </p>\n            <AvatarGroup className=\"[--ll-avatar-group-ring:var(--ll-paper)] [&>*+*]:-ms-0.5\">\n              {people.map((name) => (\n                <Avatar key={name}>\n                  <AvatarFallback name={name} />\n                </Avatar>\n              ))}\n            </AvatarGroup>\n          </div>\n\n          <Tabs defaultValue=\"today\" className=\"mt-4 gap-4\">\n            <TabsList variant=\"line\" aria-label=\"View\">\n              <TabsTrigger value=\"today\">Today</TabsTrigger>\n              <TabsTrigger value=\"week\">This week</TabsTrigger>\n            </TabsList>\n\n            <TabsContent value=\"today\">\n              <h2 className=\"sr-only\">Today</h2>\n              <div className=\"relative @2xl:pe-52\">\n                <ul role=\"list\" className=\"grid\">\n                  {TASKS.map((t) => (\n                    <li key={t.id} className=\"flex h-11 items-center gap-3\">\n                      <Checkbox\n                        id={`hero-task-${t.id}`}\n                        checked={done[t.id]}\n                        onCheckedChange={(v) => setDone((d) => ({ ...d, [t.id]: v === true }))}\n                      />\n                      <Label htmlFor={`hero-task-${t.id}`} className={cn(\"flex-1 text-[17px]\", done[t.id] && \"text-ink-muted line-through\")}>\n                        {t.label}\n                      </Label>\n                    </li>\n                  ))}\n                </ul>\n                <div className=\"pointer-events-none absolute end-0 top-0 hidden w-48 @2xl:block\">\n                  <Callout direction=\"left\" seed=\"note-a\" className=\"absolute start-0 top-11\">\n                    done before lunch\n                  </Callout>\n                  <Callout direction=\"left\" seed=\"note-b\" className=\"absolute start-0 top-33\">\n                    ask Sam first\n                  </Callout>\n                </div>\n              </div>\n\n              <div className=\"mt-5 flex flex-wrap items-center gap-x-5 gap-y-3\">\n                <div className=\"min-w-40 flex-1\">\n                  <div className=\"mb-1.5 flex items-center gap-4\">\n                    <p className=\"text-[15px] text-ink-soft\" role=\"status\" aria-live=\"polite\">\n                      <span className=\"ll-num font-bold\">{count}</span> of {TASKS.length} done\n                    </p>\n                    <Tally count={count} size=\"md\" label={`${count} tasks done`} />\n                  </div>\n                  <Progress value={count} max={TASKS.length} aria-label=\"Tasks done today\" aria-valuetext={`${count} of ${TASKS.length} done`} tone={all ? \"green\" : \"marker\"} />\n                </div>\n                {all ? <Stamp text=\"All done\" ink=\"green\" w={132} h={48} tilt={-6} className=\"animate-in zoom-in-[1.6] fade-in-0 duration-(--ll-dur-pop)\" /> : null}\n              </div>\n            </TabsContent>\n\n            <TabsContent value=\"week\">\n              <h2 className=\"sr-only\">This week</h2>\n              <ul role=\"list\" className=\"grid gap-3 py-1\">\n                {WEEK.map((d) => (\n                  <li key={d.day} className=\"grid grid-cols-[3rem_minmax(0,1fr)_3rem] items-center gap-3 text-base\">\n                    <span className=\"font-bold\">{d.day}</span>\n                    <Progress value={d.value} aria-label={`${d.day}: ${d.value}% done`} size=\"sm\" />\n                    <span className=\"ll-num text-end text-sm text-ink-muted\">{d.value}%</span>\n                  </li>\n                ))}\n              </ul>\n            </TabsContent>\n          </Tabs>\n        </Paper>\n        <Sticker name=\"party-popper\" size={88} rotate={-14} className=\"absolute -start-6 -bottom-14 z-(--ll-z-raised) hidden @xl:block\" />\n        <Sticker name=\"rating-five\" size={80} rotate={9} className=\"absolute -end-4 -bottom-11 z-(--ll-z-raised) hidden @xl:block\" />\n      </div>\n    </div>\n  )\n}\n\nexport { LandingHero02Window }\n",
      "type": "registry:component",
      "target": "@components/blocks/landing-hero-02/components/landing-hero-02-window.tsx"
    },
    {
      "path": "src/blocks/landing-hero-02/page.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\n\nimport { Button } from \"@/components/ui/button\"\nimport { Icon } from \"@/components/ui/icon\"\nimport { Lettering } from \"@/components/ui/lettering\"\nimport { Ribbon } from \"@/components/ui/ribbon\"\nimport { LandingHero02Window } from \"@/components/blocks/landing-hero-02/components/landing-hero-02-window\"\n\nexport default function LandingHero02() {\n  const titleId = React.useId()\n  return (\n    <section aria-labelledby={titleId} className=\"@container relative w-full overflow-x-clip\">\n      <div className=\"relative px-8 pt-10 pb-16 @xl:pt-14\">\n        <div className=\"mx-auto flex max-w-3xl flex-col items-center text-center [--ll-blend:normal]\">\n          <Ribbon variant=\"banner\" tone=\"tangerine\" seed=\"hero-2-ribbon\">\n            Version 2 is here\n          </Ribbon>\n          <Lettering as=\"h1\" id={titleId} size=\"xl\" tone=\"teal\" duotone=\"bubblegum\" wobble={0.4} seed=\"hero-2-title\" className=\"mt-6\">\n            Your whole week, on one page.\n          </Lettering>\n          <p className=\"mt-6 max-w-2xl text-xl/8 text-balance text-ink-soft @xl:text-[22px]/9\">\n            Tasks, notes and the odd doodle, kept together where the whole team can see them. Nothing to configure, and it&rsquo;s a pleasure to tick things off.\n          </p>\n          <div className=\"mt-8 flex flex-wrap items-center justify-center gap-x-4 gap-y-3\">\n            <Button asChild size=\"lg\">\n              <a href=\"#start\">\n                Try it free\n                <Icon name=\"arrow-right\" className=\"rtl:-scale-x-100\" />\n              </a>\n            </Button>\n            <Button asChild size=\"lg\" variant=\"secondary\">\n              <a href=\"#demo\">Book a demo</a>\n            </Button>\n          </div>\n          <p className=\"mt-4 text-[15px] text-ink-muted\">14 days of everything. Then free for small teams, for good.</p>\n        </div>\n\n        <LandingHero02Window className=\"mt-28 @xl:mt-32\" />\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/blocks/landing-hero-02/page.tsx"
    }
  ],
  "meta": {
    "tags": [
      "marketing",
      "hero",
      "landing",
      "product shot"
    ]
  },
  "docs": "Installed the \"Landing hero, centred\" block into your components directory under blocks/landing-hero-02/.\nImport it: import LandingHero02 from \"<your components alias>/blocks/landing-hero-02/page\"",
  "categories": [
    "marketing"
  ],
  "type": "registry:block"
}
