{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "cta-01",
  "title": "Call to action, ticket",
  "description": "One big admit-one ticket: riso lettering, two buttons, and a stub with Stubby celebrating and a serial number. Looks right on paper or on the desk.",
  "registryDependencies": [
    "https://kevintngo.github.io/looseleaf/r/button.json",
    "https://kevintngo.github.io/looseleaf/r/icon.json",
    "https://kevintngo.github.io/looseleaf/r/lettering.json",
    "https://kevintngo.github.io/looseleaf/r/looseleaf-theme.json",
    "https://kevintngo.github.io/looseleaf/r/mascot.json",
    "https://kevintngo.github.io/looseleaf/r/sticker.json",
    "https://kevintngo.github.io/looseleaf/r/ticket.json"
  ],
  "files": [
    {
      "path": "src/blocks/cta-01/page.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\n\nimport { Button } from \"@/components/ui/button\"\nimport { Icon } from \"@/components/ui/icon\"\nimport { Lettering } from \"@/components/ui/lettering\"\nimport { Mascot } from \"@/components/ui/mascot\"\nimport { Sticker } from \"@/components/ui/sticker\"\nimport { Ticket, TicketBody, TicketDescription, TicketNumber, TicketStub } from \"@/components/ui/ticket\"\n\nexport default function Cta01() {\n  const titleId = React.useId()\n  return (\n    <section aria-labelledby={titleId} className=\"@container w-full\">\n      <div className=\"px-4 py-14 @xl:px-8 @xl:py-20\">\n        <div className=\"relative mx-auto max-w-4xl\">\n          <Ticket stock=\"index-card\" stubWidth={112} seed=\"cta-ticket\" className=\"max-w-none\">\n            <TicketBody className=\"gap-3 px-6 py-8 @xl:px-10 @xl:py-10\">\n              <TicketDescription>Admit one team</TicketDescription>\n              <Lettering as=\"h2\" id={titleId} size=\"md\" tone=\"marker\" wobble={0.4} seed=\"cta-title\" className=\"text-start @xl:text-6xl\">\n                Ready when you are.\n              </Lettering>\n              <p className=\"max-w-lg font-hand text-lg/7 text-ink-soft\">Start a notebook in under a minute. It is free for teams of five, and there is no card to enter.</p>\n              <div className=\"mt-2 flex flex-wrap items-center gap-3\">\n                <Button asChild size=\"lg\">\n                  <a href=\"#start\">\n                    Start writing\n                    <Icon name=\"arrow-right\" className=\"rtl:-scale-x-100\" />\n                  </a>\n                </Button>\n                <Button asChild size=\"lg\" variant=\"ghost\">\n                  <a href=\"#talk\">or talk to a human</a>\n                </Button>\n              </div>\n            </TicketBody>\n            <TicketStub className=\"gap-1\">\n              <Mascot pose=\"celebrate\" size={84} />\n              <TicketNumber>No. 0001</TicketNumber>\n            </TicketStub>\n          </Ticket>\n          <Sticker name=\"party-popper\" size={76} rotate={-14} className=\"pointer-events-none absolute -start-5 -top-9 hidden @xl:block\" />\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/blocks/cta-01/page.tsx"
    }
  ],
  "meta": {
    "tags": [
      "marketing",
      "cta",
      "ticket"
    ]
  },
  "docs": "Installed the \"Call to action, ticket\" block into your components directory under blocks/cta-01/.\nImport it: import Cta01 from \"<your components alias>/blocks/cta-01/page\"",
  "categories": [
    "marketing"
  ],
  "type": "registry:block"
}