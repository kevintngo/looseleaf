{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "landing-hero-01",
  "title": "Landing hero, split",
  "description": "A headline in riso lettering with a highlighted phrase, two buttons, social proof and a collage of a polaroid, a sticky note, an index card, a sticker and Stubby, on one taped sheet. Looks right on paper or on the desk.",
  "registryDependencies": [
    "https://kevintngo.github.io/looseleaf/r/annotate.json",
    "https://kevintngo.github.io/looseleaf/r/avatar.json",
    "https://kevintngo.github.io/looseleaf/r/button.json",
    "https://kevintngo.github.io/looseleaf/r/icon.json",
    "https://kevintngo.github.io/looseleaf/r/index-card.json",
    "https://kevintngo.github.io/looseleaf/r/lettering.json",
    "https://kevintngo.github.io/looseleaf/r/looseleaf-theme.json",
    "https://kevintngo.github.io/looseleaf/r/mascot.json",
    "https://kevintngo.github.io/looseleaf/r/paper.json",
    "https://kevintngo.github.io/looseleaf/r/polaroid.json",
    "https://kevintngo.github.io/looseleaf/r/rating.json",
    "https://kevintngo.github.io/looseleaf/r/sticker.json",
    "https://kevintngo.github.io/looseleaf/r/sticky-note.json"
  ],
  "files": [
    {
      "path": "src/blocks/landing-hero-01/components/landing-hero-01-collage.tsx",
      "content": "import { IndexCard, IndexCardContent, IndexCardFooter, IndexCardHeader, IndexCardTitle } from \"@/components/ui/index-card\"\nimport { Mascot } from \"@/components/ui/mascot\"\nimport { Polaroid, PolaroidCaption, PolaroidImage } from \"@/components/ui/polaroid\"\nimport { Sticker } from \"@/components/ui/sticker\"\nimport { StickyNote, StickyNoteContent, StickyNoteTitle } from \"@/components/ui/sticky-note\"\n\nfunction LandingHero01Collage() {\n  return (\n    <div\n      data-slot=\"landing-hero-collage\"\n      className=\"mx-auto flex max-w-full flex-wrap items-start justify-center gap-x-8 gap-y-8 pt-2 @xl:relative @xl:block @xl:h-[30rem] @xl:w-[26rem] @xl:pt-0\"\n    >\n      <Polaroid seed=\"hero-photo\" tape=\"top\" tapeKind=\"washi-dots\" className=\"w-60 max-w-full @xl:absolute @xl:start-0 @xl:top-2\">\n        <PolaroidImage scene=\"hills\" label=\"A drawn hillside with one tree and a sun\" seed=\"hero-hills\" />\n        <PolaroidCaption>monday, 9:41</PolaroidCaption>\n      </Polaroid>\n\n      <StickyNote color=\"yellow\" fastener=\"pin\" seed=\"hero-todo\" className=\"w-44 @xl:absolute @xl:start-[13.5rem] @xl:top-20\">\n        <StickyNoteTitle>todo</StickyNoteTitle>\n        <StickyNoteContent>ship the new page (friday!)</StickyNoteContent>\n      </StickyNote>\n\n      <IndexCard seed=\"hero-roadmap\" fastener=\"clip\" className=\"min-h-0 w-60 max-w-full @xl:absolute @xl:start-10 @xl:top-[18rem]\">\n        <IndexCardHeader>\n          <IndexCardTitle>Roadmap</IndexCardTitle>\n        </IndexCardHeader>\n        <IndexCardContent>\n          <p>1. draw the thing</p>\n          <p>2. show a friend</p>\n          <p>3. ship it</p>\n        </IndexCardContent>\n        <IndexCardFooter>\n          <span className=\"ll-num\">no. 0042</span>\n        </IndexCardFooter>\n      </IndexCard>\n\n      <Mascot pose=\"wave\" size={184} className=\"h-[184px] w-auto @xl:absolute @xl:end-0 @xl:bottom-0\" />\n      <Sticker name=\"rocket\" size={76} rotate={10} className=\"hidden @xl:absolute @xl:-top-2 @xl:end-2 @xl:block\" />\n    </div>\n  )\n}\n\nexport { LandingHero01Collage }\n",
      "type": "registry:component",
      "target": "@components/blocks/landing-hero-01/components/landing-hero-01-collage.tsx"
    },
    {
      "path": "src/blocks/landing-hero-01/components/landing-hero-01-nav.tsx",
      "content": "import { Button } from \"@/components/ui/button\"\nimport { Mascot } from \"@/components/ui/mascot\"\n\nconst links = [\"Product\", \"Pricing\", \"Notes\", \"Changelog\"]\n\nfunction LandingHero01Nav() {\n  return (\n    <header className=\"flex items-center justify-between gap-4 pt-6\">\n      <a href=\"#top\" className=\"flex items-center gap-2 font-script text-3xl leading-none font-bold text-ink\">\n        <Mascot pose=\"idle\" size={32} />\n        penmark\n      </a>\n      <nav aria-label=\"Main\" className=\"hidden items-center gap-3 text-base text-ink @2xl:flex\">\n        {links.map((l) => (\n          <a key={l} href={`#${l.toLowerCase()}`} className=\"px-3 py-1 hover:ll-swipe\">\n            {l}\n          </a>\n        ))}\n      </nav>\n      <div className=\"flex items-center gap-3\">\n        <Button asChild variant=\"ghost\" size=\"sm\" className=\"hidden @md:inline-flex\">\n          <a href=\"#sign-in\">Sign in</a>\n        </Button>\n        <Button asChild size=\"sm\">\n          <a href=\"#start\">Get started</a>\n        </Button>\n      </div>\n    </header>\n  )\n}\n\nexport { LandingHero01Nav }\n",
      "type": "registry:component",
      "target": "@components/blocks/landing-hero-01/components/landing-hero-01-nav.tsx"
    },
    {
      "path": "src/blocks/landing-hero-01/page.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\n\nimport { Avatar, AvatarFallback, AvatarGroup, AvatarGroupCount } from \"@/components/ui/avatar\"\nimport { Button } from \"@/components/ui/button\"\nimport { Annotate } from \"@/components/ui/annotate\"\nimport { Icon } from \"@/components/ui/icon\"\nimport { Lettering } from \"@/components/ui/lettering\"\nimport { Paper } from \"@/components/ui/paper\"\nimport { Rating } from \"@/components/ui/rating\"\nimport { LandingHero01Collage } from \"@/components/blocks/landing-hero-01/components/landing-hero-01-collage\"\nimport { LandingHero01Nav } from \"@/components/blocks/landing-hero-01/components/landing-hero-01-nav\"\n\nconst people = [\"Ada Lovelace\", \"Jo Okafor\", \"Mika Kobayashi\", \"Sam Reyes\"]\n\nexport default function LandingHero01() {\n  const titleId = React.useId()\n  return (\n    <div className=\"@container relative w-full overflow-x-clip\">\n      <div className=\"p-8\">\n        <Paper\n          as=\"section\"\n          aria-labelledby={titleId}\n          stock=\"paper\"\n          tilt={false}\n          tape=\"both\"\n          tapeKind=\"washi-dots\"\n          seed=\"landing-hero-01\"\n          className=\"mx-auto w-full max-w-6xl px-5 pb-14 @xl:px-10 @xl:pb-16\"\n        >\n          <LandingHero01Nav />\n\n          <div className=\"mt-10 grid items-center gap-12 @5xl:mt-14 @5xl:grid-cols-[minmax(0,1fr)_26rem] @5xl:gap-12\">\n            <div className=\"min-w-0\">\n              <p className=\"font-type text-sm text-pencil-text\">Notes and tasks for small teams</p>\n              <Lettering as=\"h1\" id={titleId} size=\"xl\" tone=\"marker\" wobble={0.5} seed=\"hero-title\" className=\"mt-3\">\n                Write it down.\n              </Lettering>\n              <p className=\"mt-5 max-w-xl text-xl/8 text-balance text-ink-soft @xl:text-[22px]/9\">\n                Penmark keeps your team&rsquo;s notes, tasks and half-formed ideas on{\" \"}\n                <Annotate type=\"underline\" kind=\"wavy\" color=\"blue\" animate delay={600} seed=\"hero-underline\">\n                  one calm page\n                </Annotate>\n                , so the good stuff gets{\" \"}\n                <Annotate type=\"highlight\" color=\"yellow\" animate delay={1100} seed=\"hero-highlight\">\n                  found\n                </Annotate>\n                , not lost.\n              </p>\n\n              <div className=\"mt-8 flex flex-wrap items-center gap-x-4 gap-y-3\">\n                <Button asChild size=\"lg\">\n                  <a href=\"#start\">\n                    Start a notebook\n                    <Icon name=\"arrow-right\" className=\"rtl:-scale-x-100\" />\n                  </a>\n                </Button>\n                <Button asChild size=\"lg\" variant=\"outline\">\n                  <a href=\"#tour\">\n                    <Icon name=\"circle-play\" />\n                    Watch the tour\n                  </a>\n                </Button>\n              </div>\n              <p className=\"mt-4 text-[15px] text-ink-muted\">\n                <Annotate type=\"circle\" color=\"red\" animate delay={1600} seed=\"hero-free\" className=\"mx-1\">\n                  Free\n                </Annotate>{\" \"}\n                for teams of five. No card, no catch.\n              </p>\n\n              <div className=\"mt-10 flex flex-wrap items-center gap-x-5 gap-y-3\">\n                <AvatarGroup className=\"[--ll-avatar-group-ring:var(--ll-paper)] [&>*+*]:-ms-0.5\">\n                  {people.map((name) => (\n                    <Avatar key={name}>\n                      <AvatarFallback name={name} />\n                    </Avatar>\n                  ))}\n                  <AvatarGroupCount>+4k</AvatarGroupCount>\n                </AvatarGroup>\n                <div>\n                  <Rating readOnly value={4.5} allowHalf size=\"sm\" aria-label=\"Rated 4.5 out of 5 by our customers\" />\n                  <p className=\"text-sm text-ink-muted\">Loved by 4,200 small teams</p>\n                </div>\n              </div>\n            </div>\n\n            <LandingHero01Collage />\n          </div>\n        </Paper>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/blocks/landing-hero-01/page.tsx"
    }
  ],
  "meta": {
    "tags": [
      "marketing",
      "hero",
      "landing"
    ]
  },
  "docs": "Installed the \"Landing hero, split\" block into your components directory under blocks/landing-hero-01/.\nImport it: import LandingHero01 from \"<your components alias>/blocks/landing-hero-01/page\"",
