{
  "name": "looseleaf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Looseleaf: shadcn/ui, drawn by hand. React 19, Tailwind v4 and Radix components drawn on paper with clean outlines and solid colour, in the Kevin Sans hand, with a shadcn registry to install them.",
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "registry",
    "react",
    "tailwindcss",
    "tailwind-v4",
    "radix-ui",
    "components",
    "design-system",
    "hand-drawn",
    "doodle",
    "paper"
  ],
  "homepage": "https://kevintngo.github.io/looseleaf/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevintngo/looseleaf.git"
  },
  "bugs": {
    "url": "https://github.com/kevintngo/looseleaf/issues"
  },
  "license": "MIT",
  "files": [
    "registry.json",
    "public/r",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node tools/heavy.mjs vite build",
    "preview": "vite preview",
    "typecheck": "node tools/heavy.mjs tsc -p tsconfig.json --noEmit",
    "test": "node tools/heavy.mjs vitest run",
    "lookdev": "node tools/lookdev.mjs",
    "registry:build": "node tools/registry-build.mjs",
    "registry:check": "node tools/registry-build.mjs --check",
    "registry:list": "node tools/registry-build.mjs --list",
    "registry:test": "node tools/registry-consumer-test.mjs",
    "registry:test:real": "node tools/registry-consumer-test.mjs --root .",
    "registry:smoke": "node tools/registry-consumer-test.mjs --root . --only I",
    "registry:selftest": "node --test tools/registry-selftest.mjs",
    "lint:house": "node tools/heavy.mjs -- node tools/lint-house.mjs",
    "check:classes": "node tools/heavy.mjs -- node tools/check-classes.mjs",
    "check:tokens": "node tools/heavy.mjs -- node tools/check-tokens.mjs",
    "qa": "node tools/qa.mjs",
    "qa:selftest": "node tools/heavy.mjs -- node tools/qa-selftest.mjs",
    "tsx": "tsx"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-resizable-panels": "^4.13.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
